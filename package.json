{
  "name": "@shindou/skills-cli",
  "type": "module",
  "version": "0.1.34",
  "packageManager": "pnpm@10.33.0",
  "description": "Search, download and install AI Agent Skills for 30+ coding assistants",
  "author": "hikaru",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shindouhiro/skills-cli.git"
  },
  "keywords": [
    "ai",
    "agent",
    "skills",
    "cli",
    "coding-assistant"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "skills": "dist/cli.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && vite build --config vite.ui.config.ts",
    "dev": "tsdown --watch",
    "dev:ui": "vite --config vite.ui.config.ts",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "prepare": "npx simple-git-hooks",
    "release": "bumpp && git push --follow-tags",
    "start": "node dist/cli.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "catalog:prod",
    "@vueuse/core": "catalog:prod",
    "cac": "catalog:prod",
    "consola": "catalog:prod",
    "ofetch": "catalog:prod",
    "picocolors": "catalog:prod",
    "vue": "catalog:prod",
    "vue-i18n": "catalog:prod"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@types/node": "catalog:dev",
    "@vitejs/plugin-vue": "catalog:dev",
    "autoprefixer": "catalog:dev",
    "bumpp": "catalog:dev",
    "eslint": "catalog:dev",
    "lint-staged": "catalog:dev",
    "postcss": "catalog:dev",
    "simple-git-hooks": "catalog:dev",
    "tailwindcss": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
